<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="gate_medium">
    <static>true</static>

    <link name="gate_link">
      <pose>0 0 1.0 0 0 0</pose>

      <visual name="gate_visual">
        <geometry>
            <mesh>
                <uri>model://gate_medium/meshes/medium_frame.stl</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
        
        <material>
            <ambient>0.10 0.45 0.10 1</ambient>
            <diffuse>0.15 0.70 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="gate_collision">
        <geometry>
            <mesh>
                <uri>model://gate_medium/meshes/medium_frame.stl</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>