<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="black_box">
    <static>true</static>

    <link name="black_box_link">

      <visual name="black_box_visual">
        <geometry>
            <mesh>
                <uri>model://black_box/meshes/black_box.stl</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
        
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <collision name="black_box_collision">
        <geometry>
            <mesh>
                <uri>model://black_box/meshes/black_box.stl</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>