<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tmr_field">

    <!-- No world plugins on purpose: declaring any makes Gazebo skip PX4's
         server.config, which loads the physics, IMU, barometer, magnetometer,
         GPS and sensor systems PX4 needs. -->

    <!-- Environment copied from PX4's default.sdf. Without the magnetic field
         and the geographic location PX4's compass check fails ("no heading
         reference", "strong magnetic interference"). -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>5 5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="arena">
      <static>true</static>

      <link name="floor">
        <pose>5 5 -0.025 0 0 0</pose>
        <visual name="floor_visual">
          <geometry>
            <box><size>10 10 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="floor_collision">
          <geometry>
            <box><size>10 10 0.05</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
      </link>

      <link name="free_path">
        <pose>0.7 4 0.002 0 0 0</pose>
        <visual name="free_path_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 4</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://free_path/materials/textures/free_path.png</albedo_map>
                <metalness>0</metalness>
                <roughness>1</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <link name="wall_y0">
        <pose>5 0 2 0 0 0</pose>
        <visual name="wall_y0_visual">
          <transparency>0.75</transparency>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>10 0.05 4</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="wall_y0_collision">
          <geometry><box><size>10 0.05 4</size></box></geometry>
        </collision>
      </link>

      <link name="wall_y10">
        <pose>5 10 2 0 0 0</pose>
        <visual name="wall_y10_visual">
          <transparency>0.75</transparency>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>10 0.05 4</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="wall_y10_collision">
          <geometry><box><size>10 0.05 4</size></box></geometry>
        </collision>
      </link>

      <link name="wall_x0">
        <pose>0 5 2 0 0 0</pose>
        <visual name="wall_x0_visual">
          <transparency>0.75</transparency>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.05 10 4</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="wall_x0_collision">
          <geometry><box><size>0.05 10 4</size></box></geometry>
        </collision>
      </link>

      <link name="wall_x10">
        <pose>10 5 2 0 0 0</pose>
        <visual name="wall_x10_visual">
          <transparency>0.75</transparency>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.05 10 4</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="wall_x10_collision">
          <geometry><box><size>0.05 10 4</size></box></geometry>
        </collision>
      </link>

    </model>
    <include>
      <uri>model://arucotag_100</uri>
      <pose>9.9 7.5 1.6 1.5708 0 -1.5708</pose>
    </include>

    <include><uri>model://gate_big</uri><name>gate_big_1</name><pose>2.1 3.0 0 0 0 0</pose></include>
    <include><uri>model://gate_big</uri><name>gate_big_2</name><pose>2.1 3.5 0 0 0 0</pose></include>
    <include><uri>model://gate_big</uri><name>gate_big_3</name><pose>2.1 4.0 0 0 0 0</pose></include>
    <include><uri>model://gate_big</uri><name>gate_big_4</name><pose>2.1 4.5 0 0 0 0</pose></include>
    <include><uri>model://gate_big</uri><name>gate_big_5</name><pose>2.1 5.0 0 0 0 0</pose></include>

    <include><uri>model://gate_medium</uri><name>gate_medium_1</name><pose>3.6 3.0 0 0 0 0</pose></include>
    <include><uri>model://gate_medium</uri><name>gate_medium_2</name><pose>3.6 3.5 0 0 0 0</pose></include>
    <include><uri>model://gate_medium</uri><name>gate_medium_3</name><pose>3.6 4.0 0 0 0 0</pose></include>
    <include><uri>model://gate_medium</uri><name>gate_medium_4</name><pose>3.6 4.5 0 0 0 0</pose></include>
    <include><uri>model://gate_medium</uri><name>gate_medium_5</name><pose>3.6 5.0 0 0 0 0</pose></include>

    <include><uri>model://gate_small</uri><name>gate_small_1</name><pose>4.7 3.0 0 0 0 0</pose></include>
    <include><uri>model://gate_small</uri><name>gate_small_2</name><pose>4.7 3.5 0 0 0 0</pose></include>
    <include><uri>model://gate_small</uri><name>gate_small_3</name><pose>4.7 4.0 0 0 0 0</pose></include>
    <include><uri>model://gate_small</uri><name>gate_small_4</name><pose>4.7 4.5 0 0 0 0</pose></include>
    <include><uri>model://gate_small</uri><name>gate_small_5</name><pose>4.7 5.0 0 0 0 0</pose></include>

    <include><uri>model://pole</uri><name>pole_1</name><pose>3.9 6.7 0 0 0 0</pose></include>
    <include><uri>model://pole</uri><name>pole_2</name><pose>6.7 7.4 0 0 0 0</pose></include>
    <include><uri>model://pole</uri><name>pole_3</name><pose>7.5 3.0 0 0 0 0</pose></include>

    <include><uri>model://black_box</uri><name>box_1</name><pose>5.8 7.2 0 0 0 0</pose></include>
    <include><uri>model://black_box</uri><name>box_2</name><pose>7.6 5.4 0 0 0 0</pose></include>
    <include><uri>model://black_box</uri><name>box_3</name><pose>6.9 3.2 0 0 0 0</pose></include>
    <include><uri>model://black_box</uri><name>box_4</name><pose>6.1 1.0 0 0 0 0</pose></include>

  </world>
</sdf>