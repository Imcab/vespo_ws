<?xml version="1.0" ?>
<!-- Base con estación de carga (misión 7: patrullar y recargar).
     Correr con el modelo x500_cam_abajo. El patio cercado va de NED norte
     -6.0..46.0, este -35.0..35.0. La estación de carga está en NED norte 30.0, este
     18.0: plataforma de 3.4 m con el ArUco 42 (1.4 m, DICT_5X5_250) al centro.

     Generado por tools/build_worlds.py: los cambios a mano se pierden al
     regenerar. Se corre con  vespo up --sim --world base_carga
-->
<sdf version="1.9">
  <world name="base_carga">


    <!-- Sistemas declarados a mano: los del server.config de PX4 sin
         GstCameraSystem (su video H.264 acumula imágenes en memoria hasta
         llenar la RAM). Ver CAMERA_WORLD_SYSTEMS en tools/build_worlds.py. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene><ambient>0.5 0.5 0.55 1</ambient><background>0.62 0.75 0.92 1</background><sky></sky><shadows>true</shadows><grid>false</grid></scene>

<light type="directional" name="sol"><cast_shadows>true</cast_shadows><pose>0.000 0.000 60.000 0.0000 0.0000 0.0000</pose><diffuse>1.0 0.96 0.88 1</diffuse><specular>0.25 0.25 0.25 1</specular><intensity>1.0</intensity><direction>-0.45 0.4 -0.8</direction></light>
<model name="escena"><static>true</static>
