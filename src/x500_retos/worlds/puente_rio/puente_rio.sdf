<?xml version="1.0" ?>
<!-- Río con un puente de concreto (misión 2: inspeccionar un pilar).
     El pilar con bandas de colores está en Gazebo (6.5, 8.0), o sea
     NED norte 8.0 m, este 6.5 m desde donde despega el dron. Mide 0.8 m
     de radio y las bandas están a 1, 2, 3 y 4 m sobre la orilla.

     Generado por tools/build_worlds.py: los cambios a mano se pierden al
     regenerar. Se corre con  vespo up --sim --world puente_rio
-->
<sdf version="1.9">
  <world name="puente_rio">


    <!-- Sin <plugin> a propósito: si el mundo declara alguno, Gazebo ignora el
         server.config de PX4 (física, IMU, barómetro, GPS, cámaras). -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene><ambient>0.5 0.5 0.55 1</ambient><background>0.62 0.75 0.92 1</background><sky></sky><shadows>true</shadows><grid>false</grid></scene>

<light type="directional" name="sol"><cast_shadows>true</cast_shadows><pose>0.000 0.000 60.000 0.0000 0.0000 0.0000</pose><diffuse>1.0 0.96 0.88 1</diffuse><specular>0.25 0.25 0.25 1</specular><intensity>1.0</intensity><direction>-0.45 0.5 -0.75</direction></light>
