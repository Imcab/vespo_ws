<?xml version="1.0" ?>
<!-- Plaza del concierto (misión 4: geocerca).
     La caja roja es la zona permitida: Gazebo x -10.0..10.0, y -6.0..14.0,
     hasta 8.0 m de alto; en NED desde el despegue: norte -6.0..14.0,
     este -10.0..10.0. La línea naranja del piso está 1 m afuera: el
     guardián tiene que detener al dron antes de cruzarla.

     Generado por tools/build_worlds.py: los cambios a mano se pierden al
     regenerar. Se corre con  vespo up --sim --world plaza_concierto
-->
<sdf version="1.9">
  <world name="plaza_concierto">


    <!-- Sin <plugin> a propósito: si el mundo declara alguno, Gazebo ignora el
         server.config de PX4 (física, IMU, barómetro, GPS, cámaras). -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene><ambient>0.16 0.14 0.24 1</ambient><background>0.07 0.06 0.16 1</background><shadows>true</shadows><grid>false</grid></scene>

<light type="directional" name="sol"><cast_shadows>true</cast_shadows><pose>0.000 0.000 60.000 0.0000 0.0000 0.0000</pose><diffuse>1.0 0.55 0.32 1</diffuse><specular>0.25 0.25 0.25 1</specular><intensity>0.9</intensity><direction>0.9 0.25 -0.35</direction></light>
<light type="directional" name="cielo"><cast_shadows>false</cast_shadows><pose>0 0 50 0 0 0</pose><diffuse>0.12 0.14 0.28 1</diffuse><specular>0 0 0 1</specular><direction>-0.2 -0.3 -1</direction></light>
