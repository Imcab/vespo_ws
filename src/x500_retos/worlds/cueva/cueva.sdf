<?xml version="1.0" ?>
<!-- Cueva que atraviesa una montaña (misión 5: cruzarla con el lidar 2D).
     Correr con el modelo x500_lidar_2d. El túnel mide ~73 m, 5 m de ancho
     y 4.0 m de alto, con dos angosturas de 3 m y una columna de roca a medio
     camino que deja un solo paso (por la izquierda). La boca sur está 10 m al
     norte del despegue; la plataforma de salida en NED norte 84.0, este -1.0.

     Generado por tools/build_worlds.py: los cambios a mano se pierden al
     regenerar. Se corre con  vespo up --sim --world cueva
-->
<sdf version="1.9">
  <world name="cueva">


    <!-- Sin <plugin> a propósito: si el mundo declara alguno, Gazebo ignora el
         server.config de PX4 (física, IMU, barómetro, GPS, cámaras). -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene><ambient>0.18 0.18 0.2 1</ambient><background>0.62 0.75 0.92 1</background><sky></sky><shadows>true</shadows><grid>false</grid></scene>

