<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500 con cámara hacia abajo, LIGERA: 960 x 720 a 15 Hz.

  Es el x500_mono_cam_down de PX4 con otra cámara. La de PX4 manda 1280 x 960
  a 30 Hz (~110 MB/s); esta ~31 MB/s. Ojo: el plugin de video de PX4
  (GstCameraSystem) acumula imágenes y puede llenar la RAM de una laptop de
  16 GB en minutos (nos pasó): los mundos del Nivel 3 no lo cargan. Para leer ArUco
  de 1.2-1.4 m desde 12-15 m de altura sobra.

  Mismo campo de visión (1.74 rad) y misma posición que la de PX4: 10 cm abajo
  del centro, mirando derecho hacia abajo, con el frente del dron hacia arriba
  de la imagen.

  Topic en Gazebo:
    /world/<mundo>/model/x500_cam_abajo_0/link/camera_link/sensor/imager/image
-->
<sdf version="1.9">
  <model name="x500_cam_abajo">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <link name="camera_link">
      <pose>0 0 0.10 0 1.5707 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camara">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="imager" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image><width>960</width><height>720</height></image>
          <clip><near>0.1</near><far>3000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
